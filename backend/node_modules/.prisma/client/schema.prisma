generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role
  bugs      Bug[]
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  bugs        Bug[]
  createdAt   DateTime @default(now())
}

model Bug {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    Severity
  priority    Priority
  status      Status   @default(NEW)
  projectId   String
  assigneeId  String?
  project     Project  @relation(fields: [projectId], references: [id])
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
  TESTER
  USER
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Priority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

enum Status {
  NEW
  ASSIGNED
  IN_PROGRESS
  FIXED
  TESTING
  VERIFIED
  CLOSED
  REOPENED
}
